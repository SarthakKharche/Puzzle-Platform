# Cloud PostgreSQL connection string
# Example: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=

# PostgreSQL pool tuning
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=10000

# SSL behavior for managed cloud DB
PG_SSL=true
PG_SSL_REJECT_UNAUTHORIZED=false

# Optional for Prisma shadow DB in migrations
SHADOW_DATABASE_URL=
